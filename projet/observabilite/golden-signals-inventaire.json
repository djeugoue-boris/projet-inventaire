{
  "title": "Golden Signals - Inventaire",
  "uid": "inventaire-golden",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "inventaire",
    "golden-signals"
  ],
  "templating": {
    "list": [
      {
        "name": "ds_prom",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "ds_loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki"
      },
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "query": {
          "query": "label_values(kube_pod_info, namespace)",
          "refId": "ns"
        },
        "definition": "label_values(kube_pod_info, namespace)",
        "current": {
          "text": "inventaire",
          "value": "inventaire"
        },
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Latence (p50 / p95 / p99)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", service=\"inventaire-api\", route!=\"/metrics\"}[2m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", service=\"inventaire-api\", route!=\"/metrics\"}[2m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", service=\"inventaire-api\", route!=\"/metrics\"}[2m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Trafic",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum(rate(http_request_duration_seconds_count{namespace=\"$namespace\", service=\"inventaire-api\", route!=\"/metrics\"}[2m]))",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Erreurs 5xx",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "(sum(rate(http_request_duration_seconds_count{namespace=\"$namespace\", service=\"inventaire-api\", status=~\"5..\"}[2m])) or vector(0)) / sum(rate(http_request_duration_seconds_count{namespace=\"$namespace\", service=\"inventaire-api\"}[2m]))",
          "legendFormat": "erreurs"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Saturation (CPU / memoire par Pod)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 6,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container!=\"\"}[2m]))",
          "legendFormat": "CPU {{pod}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\", container!=\"\"})",
          "legendFormat": "Mem {{pod}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Replicas API (HPA)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"$namespace\"}",
          "legendFormat": "actuels"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"$namespace\"}",
          "legendFormat": "desires"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Logs API (erreurs)",
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 9
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "{namespace=\"$namespace\", app=\"inventaire-api\"} |= \"error\""
        }
      ]
    }
  ]
}